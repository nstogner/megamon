items:
- apiVersion: jobset.x-k8s.io/v1alpha2
  kind: JobSet
  metadata:
    annotations:
      tpu-provisioner.cloud.google.com/slice-selection: '{"myjob": [["a000t4x4x4",
        "b000t4x4x4"]]}'
    creationTimestamp: "2025-12-08T18:02:05Z"
    finalizers:
    - tpu-provisioner.cloud.google.com/slice-cleanup
    generateName: t4x4x8r1-
    generation: 3
    labels:
      kwok-simulated-job: "true"
      tpu-provisioner.cloud.google.com/slice-autoprovisioning: async
    name: t4x4x8r1-42z4c
    namespace: default
    resourceVersion: "2185"
    uid: 6ea24954-90d9-47a5-8a8e-9419a1c45dce
  spec:
    failurePolicy:
      maxRestarts: 100
      restartStrategy: Recreate
    network:
      enableDNSHostnames: true
      publishNotReadyAddresses: true
    replicatedJobs:
    - name: myjob
      replicas: 1
      template:
        metadata:
          labels:
            tpu-provisioner.cloud.google.com/inject-slice-selector: "true"
        spec:
          backoffLimit: 0
          completionMode: Indexed
          completions: 32
          parallelism: 32
          template:
            metadata:
              annotations:
                cloud.google.com/gke-tpu-topology: 4x4x8
              labels:
                app: my-job
            spec:
              containers:
              - command:
                - bash
                - -c
                - |
                  printenv
                  pip install "jax[tpu]" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html
                  python -c 'import os; print(os.environ, flush=True); import jax; print("Global device count:", jax.device_count(), "Local device count:", jax.local_device_count())'
                image: python:3.8
                name: jax
                ports:
                - containerPort: 8471
                  protocol: TCP
                - containerPort: 8080
                  protocol: TCP
                resources:
                  limits:
                    google.com/tpu: "4"
                  requests:
                    google.com/tpu: "4"
                securityContext:
                  privileged: true
              nodeSelector:
                cloud.google.com/gke-tpu-accelerator: tpu7x
              restartPolicy: Never
              tolerations:
              - effect: NoSchedule
                key: google.com/tpu
                operator: Exists
    startupPolicy:
      startupPolicyOrder: AnyOrder
    successPolicy:
      operator: All
  status:
    replicatedJobsStatus:
    - active: 1
